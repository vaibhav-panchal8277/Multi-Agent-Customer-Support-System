# Rename this file to `.env` after filling in your keys:
#   mv env.example .env      (mac / linux)
#   ren env.example .env     (windows cmd)
#
# Public URL where the FastAPI backend is reachable from the browser.
# Local dev:  http://localhost:8001
# Prod:       https://your-deployment.example.com
REACT_APP_BACKEND_URL=http://localhost:8001

# CRA / dev-server tweaks (leave defaults for local dev)
WDS_SOCKET_PORT=3000
