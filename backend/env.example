# Rename this file to `.env` after filling in your keys:
#   mv env.example .env      (mac / linux)
#   ren env.example .env     (windows cmd)
#
# ---- MongoDB ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="support_platform"

# ---- CORS (comma-separated, or * for open demo) ----
CORS_ORIGINS="*"

# ---- LLM: Groq API key ----
# Get yours from https://console.groq.com -> API Keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: override the model (defaults to openai/gpt-oss-120b)
# GROQ_MODEL="openai/gpt-oss-120b"

# ---- Guardrails (NeMo) ----
# Model used for the input/output safety rails. Optional; defaults to GROQ_MODEL
# (openai/gpt-oss-120b).
# GUARDRAILS_MODEL="openai/gpt-oss-120b"

# ---- Langfuse observability (https://cloud.langfuse.com -> Project Settings -> API Keys) ----
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_HOST="https://us.cloud.langfuse.com"

# ---- API auth (issue C3) ----
# Shared bearer token required by every /api endpoint. Empty = auth disabled
# (fine for local dev). In production set a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and set the SAME value in frontend/.env as REACT_APP_API_TOKEN.
API_TOKEN=""
