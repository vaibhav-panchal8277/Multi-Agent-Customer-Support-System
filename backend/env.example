# Rename this file to `.env` after filling in your keys:
#   mv env.example .env      (mac / linux)
#   ren env.example .env     (windows cmd)
#
# ---- MongoDB ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="support_platform"

# ---- CORS (comma-separated, or * for open demo) ----
CORS_ORIGINS="*"

# ---- LLM: Emergent Universal Key (works for OpenAI / Anthropic / Gemini text) ----
# Get yours from your Emergent profile -> Manage plan -> Universal Key
EMERGENT_LLM_KEY="sk-emergent-xxxxxxxxxxxxxxxx"

# ---- Guardrails (NeMo) ----
# Model used for the input/output safety rails. Optional; defaults to gpt-5.4-mini.
# GUARDRAILS_MODEL="gpt-5.4-mini"

# ---- Langfuse observability (https://cloud.langfuse.com -> Project Settings -> API Keys) ----
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_HOST="https://us.cloud.langfuse.com"
