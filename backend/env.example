# Rename this file to `.env` after filling in your keys:
#   mv env.example .env      (mac / linux)
#   ren env.example .env     (windows cmd)
#
# ---- MongoDB ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="support_platform"

# ---- CORS (comma-separated, or * for open demo) ----
CORS_ORIGINS="*"

# ---- LLM: Groq API key ----
# Get yours from https://console.groq.com -> API Keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: override the model (defaults to openai/gpt-oss-120b)
# GROQ_MODEL="openai/gpt-oss-120b"

# ---- Guardrails (NeMo) ----
# Model used for the input/output safety rails. Optional; defaults to GROQ_MODEL
# (openai/gpt-oss-120b).
# GUARDRAILS_MODEL="openai/gpt-oss-120b"

# ---- Langfuse observability (https://cloud.langfuse.com -> Project Settings -> API Keys) ----
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_HOST="https://us.cloud.langfuse.com"

# Guardrail behaviour when a rail can't run (after retries): "closed" (default,
# block) or "open" (allow — local dev only).
# GUARDRAILS_FAIL_MODE="closed"

# ---- API auth ----
# Optional shared client key sent as `Authorization: Bearer ...`. The frontend
# must ship it as REACT_APP_API_TOKEN, which makes it PUBLIC — it only keeps
# casual traffic off the API and is not a security boundary. Empty = disabled.
# Conversations are protected by per-session keys (no configuration needed).
API_TOKEN=""

# ---- Rate limits (per minute, per process; 0 = off) ----
# CHAT_RATE_LIMIT_PER_MIN="20"       # messages per conversation
# SESSION_RATE_LIMIT_PER_MIN="30"    # new conversations per client IP

# Server-side secret for admin endpoints (list all sessions, traces, status).
# Sent as `X-Admin-Token`; typed into /admin at runtime. NEVER put this in the
# frontend .env. Empty = admin endpoints disabled. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=""
