# ---- MongoDB ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="support_platform"

# ---- CORS (comma-separated, or * for open demo) ----
CORS_ORIGINS="*"

# ---- LLM: Emergent Universal Key (works for OpenAI / Anthropic / Gemini text) ----
